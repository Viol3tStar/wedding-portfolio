---
const contactInfo = {
  email: "wedding@example.com",
  phone: "+1 (555) 123-4567",
  whatsapp: "+1 (555) 123-4567",
};
---

<section class="contact">
  <h2>Contact Us</h2>
  <div class="contact-info">
    <div class="info-item">
      <h3>Email</h3>
      <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
    </div>
    <div class="info-item">
      <h3>Phone</h3>
      <a href={`tel:${contactInfo.phone}`}>{contactInfo.phone}</a>
    </div>
    <div class="info-item">
      <h3>WhatsApp</h3>
      <a href={`https://wa.me/${contactInfo.whatsapp}`}>Message us</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 4rem 2rem;
    background-color: #fafafa;
  }

  h2 {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-info {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    text-align: center;
  }

  a {
    color: #666;
    text-decoration: none;
    transition: color 0.3s;
  }

  a:hover {
    color: #333;
  }
</style>

