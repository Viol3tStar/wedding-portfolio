---
const venueDetails = {
  name: "Grand Plaza Hotel",
  address: "123 Wedding Avenue, City, Country",
  mapUrl: "https://www.google.com/maps/embed?pb=YOUR_MAPS_EMBED_URL",
};
---

<section class="location">
  <h2>Wedding Venue</h2>
  <div class="venue-details">
    <h3>{venueDetails.name}</h3>
    <p>{venueDetails.address}</p>
    <div class="map">
      <iframe
        src={venueDetails.mapUrl}
        width="100%"
        height="450"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location {
    padding: 4rem 2rem;
    background-color: #fff;
  }

  h2 {
    text-align: center;
    margin-bottom: 3rem;
  }

  .venue-details {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .map {
    margin-top: 2rem;
    border-radius: 8px;
    overflow: hidden;
  }
</style>

