---
const images = [
  { src: "/images/deco1.jpg", alt: "Wedding Decoration 1" },
  { src: "/images/deco2.jpg", alt: "Wedding Decoration 2" },
  { src: "/images/deco3.jpg", alt: "Wedding Decoration 3" },
];
---

<section class="gallery">
  <h2>Our Wedding Theme</h2>
  <div class="image-grid">
    {
      images.map((image) => (
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
        />
      ))
    }
  </div>
</section>

<style>
  .gallery {
    padding: 4rem 2rem;
    background-color: #fafafa;
  }

  h2 {
    text-align: center;
    margin-bottom: 3rem;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 8px;
  }
</style>

